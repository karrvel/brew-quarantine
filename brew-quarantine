def outdated_packages() -> list[str]:
    proc = brew("outdated", "--json=v2")
    if proc.returncode != 0:
        return []
    try:
        d = json.loads(proc.stdout)
    except json.JSONDecodeError:
        return []
    names = [f["name"] for f in d.get("formulae", []) if not f.get("pinned")]
    names += [k["name"] for k in d.get("casks", []) if not k.get("pinned")]
    return names


def cmd_gate(args, action: str) -> int:
    cache = DateCache(CACHE_PATH)

    if args.bypass:
        print(YELLOW("Cooldown bypassed (--bypass). Running brew directly."), file=sys.stderr)
        return subprocess.run(["brew", action, *args.brew_args, *args.packages]).returncode

    # Progress chatter goes to stderr so that --json emits parseable stdout.
    if not args.no_update:
        print(DIM("==> brew update"), file=sys.stderr)
        subprocess.run(["brew", "update", "--quiet"], env=brew_env())

    requested = args.packages or (outdated_packages() if action == "upgrade" else [])
    if not requested:
        print(GREEN("Nothing to do — no outdated packages." if action == "upgrade" else "No packages given."))
        return 0

    print(DIM(f"==> resolving plan and ages for {len(requested)} package(s)…"), file=sys.stderr)
    survivors, plan, held, unenforceable, skipped, leaked, implicit = evaluate(
        action, requested, args.days, args.brew_args, cache, args.verbose, args.allow_unknown
    )

    if args.json:
        print(json.dumps({
            "action": action,
            "days": args.days,
            "cleared": plan,
            "held": {
                n: {"age_days": h.days, "date": h.date, "reason": h.reason,
                    "clears_on": h.clears_on(args.days), "kind": h.pkg.kind}
                for n, h in held.items()
            },
            "cannot_enforce": [{"name": p.name, "why": p.why_unenforceable} for p in unenforceable],
            "skipped": skipped,
            "verification_failed": leaked,
            "held_transitively": implicit,
        }, indent=2))
        return 2 if leaked else 0

    print_report(args.days, survivors, plan, held, unenforceable, action, skipped, leaked, implicit)

    if leaked:
        return 2
    if not survivors:
        return 0
    if args.dry_run:
        print(DIM("--dry-run: stopping before execution."))
        return 0

    print(BOLD(f"==> brew {action} {' '.join(survivors)}"))
    return subprocess.run(
        ["brew", action, *args.brew_args, *survivors], env=brew_env()
    ).returncode


def cmd_status(args) -> int:
    cache = DateCache(CACHE_PATH)
    requested = args.packages or outdated_packages()
    if not requested:
        print(GREEN("No outdated packages."))
        return 0
    now = datetime.now(timezone.utc)
    meta = load_metadata(requested)
    pkgs = [meta[n] for n in requested if n in meta]
    dates = lookup_dates(pkgs, cache)

    rows = []
    for p in pkgs:
        iso = dates.get(p.name)
        a = age_days(iso, now) if iso else None
        rows.append((p, iso, a))
    rows.sort(key=lambda r: (r[2] is None, r[2] if r[2] is not None else 0))

    width = max(len(p.name) for p, _, _ in rows)
    print()
    print(BOLD(f"Outdated packages by age of their tap definition (cooldown = {args.days}d)"))
    print()
    for p, iso, a in rows:
        if a is None:
            mark, age = YELLOW("  ?  "), "unknown"
        elif a < args.days:
            mark, age = RED(" HELD"), f"{a:.1f}d"
        else:
            mark, age = GREEN(" OK  "), f"{a:.1f}d"
        extra = DIM(f"  ({p.why_unenforceable})") if p.unenforceable else ""
        print(f" {mark}  {p.name.ljust(width)}  {age:>8}  {DIM(p.tap)}{extra}")
    print()
    return 0


def main() -> int:
    def add_global_flags(p, suppress: bool) -> None:
        """Global flags, added to both the main parser and every subparser.

        The subparser copies use default=SUPPRESS so that a flag given *before* the
        subcommand is not silently overwritten by the subparser's own default. That lets
        both `brew-quarantine --dry-run upgrade` and the more natural `brew upgrade
        --dry-run` work identically.
        """
        def kw(default):
            return {"default": argparse.SUPPRESS} if suppress else {"default": default}

        p.add_argument("--days", type=int, **kw(DEFAULT_DAYS),
                       help=f"cooldown window in days (default {DEFAULT_DAYS}, env BREW_QUARANTINE_DAYS)")
        # Named --bypass, not --no-quarantine, to avoid confusion with Homebrew's own
        # (now-deprecated) --no-quarantine, which is about macOS Gatekeeper, not cooldowns.
        p.add_argument("--bypass", action="store_true", **kw(False),
                       help="skip the gate and run brew directly")
        p.add_argument("--dry-run", action="store_true", **kw(False),
                       help="report only; do not run brew")
        p.add_argument("--no-update", action="store_true", **kw(False),
                       help="skip the initial `brew update`")
        p.add_argument("--allow-unknown", action="store_true", **kw(False),
                       help="let packages whose age cannot be determined through (default: hold them)")
        p.add_argument("--json", action="store_true", **kw(False),
                       help="machine-readable output")
        p.add_argument("-v", "--verbose", action="store_true", **kw(False))

    ap = argparse.ArgumentParser(
        prog="brew-quarantine",
        description="Enforce a minimum age (cooldown) on Homebrew installs and upgrades. "
                    "This is a supply-chain delay, not macOS Gatekeeper quarantine.",
    )
    add_global_flags(ap, suppress=False)

    sub = ap.add_subparsers(dest="cmd", required=True)
    for name, help_text in (
        ("upgrade", "upgrade only packages that have cleared the cooldown"),
        ("install", "install only if the package and its deps have cleared the cooldown"),
        ("status", "show outdated packages and how long until each clears"),
    ):
        s = sub.add_parser(name, help=help_text)
        s.add_argument("packages", nargs="*")
        s.add_argument("--brew-arg", dest="brew_args", action="append", default=[],
                       help="extra argument passed through to brew (repeatable)")
        add_global_flags(s, suppress=True)

    args = ap.parse_args()
    if args.cmd == "status":
        return cmd_status(args)
    return cmd_gate(args, args.cmd)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        print("\nInterrupted.", file=sys.stderr)
        sys.exit(130)
